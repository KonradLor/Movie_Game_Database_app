// Media Databank - duomenu bazes schema
// Visi parsiusti duomenys saugomi lokaliai (write-through cache, Faze 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// ENUMAI
// ----------------------------------------------------------------------

enum MediaType {
  MOVIE // Filmas
  SERIES // Serialas
  ANIME // Anime
  DOCUMENTARY // Dokumentika
  GAME // Zaidimas
}

enum Visibility {
  PUBLIC // Matomas visiems
  UNLISTED // Tik su tiesiogine nuoroda
  PRIVATE // Tik adminui prisijungus
}

enum MediaStatus {
  WATCHED // Jau ziureta/zaista
  WATCHLIST // Noriu paziureti (Faze 7)
}

enum DataSource {
  TMDB
  IGDB
  MANUAL
}

// Zaidimo platforma (kur zaista/praeita). Tik GAME tipui.
enum GamePlatform {
  PC
  STEAM
  PLAYSTATION
  XBOX
  NINTENDO_SWITCH
  MOBILE
  OTHER
}

// Draugystes busena (abipusis patvirtinimas: uzklausa -> priimta).
enum FriendStatus {
  PENDING // issiusta uzklausa, laukiama patvirtinimo
  ACCEPTED // draugai
}

enum CreditRole {
  ACTOR // Aktorius
  DIRECTOR // Rezisierius
  WRITER // Scenaristas
  CREATOR // Kurejas
  DESIGNER // Zaidimo dizaineris
  DEVELOPER // Zaidimo kurejas (kompanija)
  PUBLISHER // Leidejas (kompanija)
  STUDIO // Studija (kompanija)
}

// ----------------------------------------------------------------------
// VARTOTOJAS (daugiavartotojiskumas - kiekvienas turi savo dienorasti)
// ----------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  sub        String   @unique // Authentik subject (sub_mode=email -> el. pastas)
  email      String?
  name       String?
  userNumber Int      @unique // eiles nr. (1..N) - API raktu gating (FAZE C)
  isAdmin    Boolean  @default(false)

  // FAZE C - savi API raktai (21-as ir veliau). Kol kas null = naudoja bendrus.
  tmdbReadToken      String?
  tmdbApiKey         String?
  twitchClientId     String?
  twitchClientSecret String?

  // Suaugusiuju turinio filtras. false (numatyta) = pornografija/adult blokuojama
  // paieskoje ir importe. Vartotojas gali issijungti profilyje savo rizika.
  allowAdult Boolean @default(false)

  // Kada paskutini karta ziurejo sekamu draugu veiklos srauta (/sekimas) -
  // "nauja veikla" badge skaicius = irasu su activityAt > sio laiko.
  followFeedSeenAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mediaItems MediaItem[]

  // Socialiniai rysiai (draugyste + rekomendacijos + sekimas)
  sentFriendRequests      Friendship[]     @relation("FriendRequester")
  receivedFriendRequests  Friendship[]     @relation("FriendAddressee")
  sentRecommendations     Recommendation[] @relation("RecFrom")
  receivedRecommendations Recommendation[] @relation("RecTo")
  following               Follow[]         @relation("Follower")
  followers               Follow[]         @relation("Following")

  @@index([userNumber])
}

// ----------------------------------------------------------------------
// PAGRINDINIS IRASAS
// ----------------------------------------------------------------------

model MediaItem {
  id          String      @id @default(cuid())

  // Savininkas (daugiavartotojiskumas) - kiekvienas irasas priklauso vartotojui
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        MediaType
  title       String // numatytoji/atsargine kalba (EN)
  originalTitle String?
  year        Int?
  durationMin Int? // trukme minutemis
  description String? // aprasymas numatytaja/atsargine kalba (EN)

  // Daugiakalbis turinys: { "en": {title, description}, "de": {...}, "lt": {...} }
  // Uzpildomas importuojant is TMDB (3 kalbos). Rodant - parenkama pagal UI kalba,
  // atsargine varianta - EN (title/description laukai virsuje).
  translations Json?
  posterUrl   String? // isorinis (TMDB CDN)
  localPoster String? // parsisiustas i serveri (Faze 4)

  // Asmenine informacija
  rating      Int? // ivertinimas (pvz. 1-5 arba 1-10)
  opinion     String? // mano nuomone / komentaras
  status      MediaStatus @default(WATCHED)
  watchCount  Int         @default(1) // kiek kartu ziureta
  firstWatched DateTime? // pirma perziura
  lastWatched DateTime? // paskutine perziura

  // Veiklos laikas draugu sekimo srautui: keliamas pridedant irasa ir pazymint
  // "ziureta" (markWatched), bet NE atnaujinant metaduomenis is saltinio. Pagal ji
  // rikiuojamas srautas (kad "pazymejo ziureta" irgi issoktu i virsu).
  activityAt  DateTime?

  // Zaidimams (GAME) skirti asmeniniai laukai
  platform     GamePlatform? // kurioje platformoje zaista/praeita
  playedHours  Float? // kiek valandu is viso zaista
  beatenHours  Float? // kiek valandu reikejo praeiti
  platinum     Boolean @default(false) // platinum / 100% pasiekimai / perejimas

  // Privatumas
  visibility  Visibility  @default(PUBLIC)

  // Saltinis / kesavimas
  source      DataSource  @default(MANUAL)
  tmdbId      Int?
  igdbId      Int?
  cachedAt    DateTime? // kada paskutini karta atnaujinta is saltinio

  // Rysiai
  tags        TagOnMedia[]
  credits     Credit[]
  watchLogs   WatchLog[]
  recommendations Recommendation[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, type, tmdbId])
  @@unique([userId, type, igdbId])
  @@index([userId])
  @@index([type])
  @@index([visibility])
  @@index([status])
  @@index([activityAt])
}

// ----------------------------------------------------------------------
// PERZIURU ISTORIJA (rewatch, Faze 7)
// ----------------------------------------------------------------------

model WatchLog {
  id        String    @id @default(cuid())
  mediaId   String
  media     MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchedAt DateTime
  note      String?
  createdAt DateTime  @default(now())

  @@index([mediaId])
  @@index([watchedAt])
}

// ----------------------------------------------------------------------
// ZYMOS / TAGAI
// ----------------------------------------------------------------------

model Tag {
  id    String       @id @default(cuid())
  name  String       @unique
  media TagOnMedia[]
}

model TagOnMedia {
  mediaId String
  tagId   String
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
}

// ----------------------------------------------------------------------
// ASMENYS (aktoriai, rezisieriai, dizaineriai) - Faze 4b
// ----------------------------------------------------------------------

model Person {
  id           String   @id @default(cuid())
  name         String
  bio          String?
  photoUrl     String?
  localPhoto   String?
  tmdbId       Int?     @unique
  igdbId       Int?     @unique
  worksCachedAt DateTime? // kada filmografija paskutini karta parsiusta
  cachedWorks  Json? // kesuota TMDB filmografija (ne kolekcijos dalis)
  credits      Credit[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

// ----------------------------------------------------------------------
// KOMPANIJOS (studijos, leidejai, developeriai) - Faze 4b
// ----------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  tmdbId    Int?     @unique
  igdbId    Int?     @unique
  credits   Credit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ----------------------------------------------------------------------
// KREDITAI (jungtis: irasas <-> asmuo/kompanija su vaidmeniu)
// ----------------------------------------------------------------------

model Credit {
  id        String     @id @default(cuid())
  role      CreditRole
  character String? // veikejo vardas (aktoriams)
  mediaId   String
  media     MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  personId  String?
  person    Person?    @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([personId])
  @@index([companyId])
}

// ----------------------------------------------------------------------
// DRAUGYSTE (abipuse: uzklausa -> priimta). Pridedama pagal draugo koda (#userNumber).
// ----------------------------------------------------------------------

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

// ----------------------------------------------------------------------
// REKOMENDACIJA (draugui: koki filma/zaidima ziureti/zaisti + zinute "kodel").
// Snapshot laukai (mediaTitle/Type/Poster) leidzia rekomendacijai islikti net
// istrynus originalu irasa (mediaId tada -> NULL).
// ----------------------------------------------------------------------

model Recommendation {
  id          String     @id @default(cuid())
  fromId      String
  from        User       @relation("RecFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          User       @relation("RecTo", fields: [toId], references: [id], onDelete: Cascade)
  mediaId     String?
  media       MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  mediaTitle  String
  mediaType   MediaType
  mediaPoster String?
  message     String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([toId])
  @@index([fromId])
  @@index([mediaId])
}

// ----------------------------------------------------------------------
// SEKIMAS (kryptinis: as seku drauga -> jo nauja vieša veikla matoma mano
// pagrindiniame puslapyje). Leidziamas tik tarp draugu.
// ----------------------------------------------------------------------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
