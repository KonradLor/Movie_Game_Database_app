# =========================================================================
# Media Databank - .env SABLONAS (be reiksmiu). Nukopijuok i .env ir uzpildyk.
# =========================================================================

# --- TMDB (filmai / serialai / anime / dokumentika) ---
TMDB_READ_TOKEN=
TMDB_API_KEY=

# --- IGDB per Twitch (zaidimai) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Authentik OIDC (Faze 3) ---
AUTHENTIK_ISSUER=https://auth.kondev.app/application/o/media/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Auth.js paslaptis (sugeneruok: openssl rand -base64 32)
AUTH_SECRET=
# Admin el. pastas (kam suteikiamos admin teises)
ADMIN_EMAIL=

# --- Duomenu baze (Faze 2) ---
DATABASE_URL=postgresql://moviedb:PASSWORD@localhost:5432/moviedb
POSTGRES_PASSWORD=

# --- Admin API raktas (Faze 4c) - PASIRENKAMA (opt-in) ---
# Tuscia = admin API + MCP ISJUNGTI. Nustatyk ilga atsitiktini raktа, jei nori ijungti.
ADMIN_API_KEY=
